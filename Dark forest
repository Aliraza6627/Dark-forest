let player;
let trees = [];
let fireflies = [];
let monsters = [];
let score = 0;
let totalFireflies = 10;
let gameState = 'START';
let fogBuffer;

function setup() {
    let canvas = createCanvas(800, 600);
    canvas.parent('canvas-container');

    fogBuffer = createGraphics(width, height);
    initGame();
}

function initGame() {
    player = new Player(width / 2, height / 2);
    score = 0;

    trees = [];
    for (let i = 0; i < 45; i++) {
        trees.push(new Tree(random(width), random(height)));
    }

    fireflies = [];
    for (let i = 0; i < totalFireflies; i++) {
        fireflies.push(new Firefly(random(50, width - 50), random(50, height - 50)));
    }

    monsters = [];
    for (let i = 0; i < 4; i++) {
        let mx = random() < 0.5 ? random(0, 100) : random(width - 100, width);
        let my = random() < 0.5 ? random(0, 100) : random(height - 100, height);
        monsters.push(new Monster(mx, my));
    }
}

function draw() {
    background(8, 12, 10);

    if (gameState === 'START') {
        drawStartScreen();
    } else if (gameState === 'PLAYING') {
        updateAndDrawGame();
    } else if (gameState === 'GAMEOVER') {
        drawGameOverScreen();
    } else if (gameState === 'WIN') {
        drawWinScreen();
    }
}

function updateAndDrawGame() {
    drawEnvironment();

    for (let i = fireflies.length - 1; i >= 0; i--) {
        fireflies[i].update();
        fireflies[i].draw();

        if (fireflies[i].checkCollect(player)) {
            fireflies.splice(i, 1);
            score++;
            if (fireflies.length === 0) {
                gameState = 'WIN';
            }
        }
    }

    player.update();
    player.draw();

    for (let tree of trees) {
        tree.draw();
    }

    for (let monster of monsters) {
        monster.update(player);
        monster.draw();

        if (monster.checkHitPlayer(player)) {
            gameState = 'GAMEOVER';
        }
    }

    drawDarknessAndFlashlight();
    drawUI();
}

function drawDarknessAndFlashlight() {
    fogBuffer.clear();
    fogBuffer.background(5, 7, 6, 245);

    fogBuffer.push();
    fogBuffer.blendMode(REMOVE);

    let angle = atan2(mouseY - player.y, mouseX - player.x);
    
    fogBuffer.noStroke();
    fogBuffer.fill(255);
    fogBuffer.beginShape();
    fogBuffer.vertex(player.x, player.y);
    fogBuffer.arc(player.x, player.y, 400, 400, angle - PI / 5, angle + PI / 5, PIE);
    fogBuffer.endShape(CLOSE);

    fogBuffer.circle(player.x, player.y, 90);

    fogBuffer.pop();

    image(fogBuffer, 0, 0);

    push();
    noStroke();
    let aimAngle = atan2(mouseY - player.y, mouseX - player.x);
    fill(255, 240, 180, 25);
    arc(player.x, player.y, 410, 410, aimAngle - PI / 5, aimAngle + PI / 5, PIE);
    pop();
}

function drawEnvironment() {
    stroke(15, 25, 18);
    strokeWeight(1);
    for (let x = 0; x < width; x += 40) {
        for (let y = 0; y < height; y += 40) {
            point(x + ((y * 17) % 20), y + ((x * 13) % 20));
        }
    }
}

function drawUI() {
    fill(180, 255, 180);
    textSize(18);
    textAlign(LEFT, TOP);
    text("Glowworms Collected: " + score + " / " + totalFireflies, 20, 20);
}

function drawStartScreen() {
    textAlign(CENTER, CENTER);
    fill(150, 220, 150);
    textSize(38);
    text("DARK FOREST SURVIVAL", width / 2, height / 2 - 50);

    textSize(18);
    fill(200);
    text("Tarkik jangal me glowing insects dhoondo.", width / 2, height / 2 + 10);
    text("Bhoot/Monsters se bacho, Mouse se torch light ghumao.", width / 2, height / 2 + 40);

    fill(100, 255, 100);
    text("Press [ ENTER ] or CLICK to Start", width / 2, height / 2 + 100);
}

function drawGameOverScreen() {
    fill(0, 0, 0, 200);
    rect(0, 0, width, height);

    textAlign(CENTER, CENTER);
    fill(255, 50, 50);
    textSize(42);
    text("GAME OVER", width / 2, height / 2 - 40);

    textSize(20);
    fill(220);
    text("Jangal k bhoot ne aapko pakar liya!", width / 2, height / 2 + 10);

    fill(100, 255, 100);
    text("Press [ ENTER ] or CLICK to Restart", width / 2, height / 2 + 70);
}

function drawWinScreen() {
    fill(0, 0, 0, 200);
    rect(0, 0, width, height);

    textAlign(CENTER, CENTER);
    fill(100, 255, 100);
    textSize(42);
    text("VICTORY!", width / 2, height / 2 - 40);

    textSize(20);
    fill(220);
    text("Aapne sari lights collect kar leen!", width / 2, height / 2 + 10);

    fill(255);
    text("Press [ ENTER ] or CLICK to Play Again", width / 2, height / 2 + 70);
}

function keyPressed() {
    if ((gameState === 'START' || gameState === 'GAMEOVER' || gameState === 'WIN') && keyCode === ENTER) {
        initGame();
        gameState = 'PLAYING';
    }
}

function mousePressed() {
    if (gameState === 'START' || gameState === 'GAMEOVER' || gameState === 'WIN') {
        initGame();
        gameState = 'PLAYING';
    }
}

class Player {
    constructor(x, y) {
        this.x = x;
        this.y = y;
        this.speed = 3;
        this.radius = 12;
    }

    update() {
        if (keyIsDown(87) || keyIsDown(UP_ARROW)) this.y -= this.speed;
        if (keyIsDown(83) || keyIsDown(DOWN_ARROW)) this.y += this.speed;
        if (keyIsDown(65) || keyIsDown(LEFT_ARROW)) this.x -= this.speed;
        if (keyIsDown(68) || keyIsDown(RIGHT_ARROW)) this.x += this.speed;

        this.x = constrain(this.x, this.radius, width - this.radius);
        this.y = constrain(this.y, this.radius, height - this.radius);
    }

    draw() {
        fill(200, 220, 255);
        stroke(50, 100, 150);
        strokeWeight(2);
        circle(this.x, this.y, this.radius * 2);
    }
}

class Tree {
    constructor(x, y) {
        this.x = x;
        this.y = y;
        this.size = random(25, 45);
    }

    draw() {
        noStroke();
        fill(15, 30, 20);
        circle(this.x, this.y, this.size);
        fill(25, 55, 35);
        circle(this.x - 2, this.y - 2, this.size * 0.85);
    }
}

class Firefly {
    constructor(x, y) {
        this.x = x;
        this.y = y;
        this.angle = random(TWO_PI);
    }

    update() {
        this.x += cos(this.angle) * 0.5;
        this.y += sin(this.angle) * 0.5;
        this.angle += random(-0.2, 0.2);

        this.x = constrain(this.x, 20, width - 20);
        this.y = constrain(this.y, 20, height - 20);
    }

    draw() {
        noStroke();
        fill(150, 255, 100, 100);
        circle(this.x, this.y, 12);
        fill(230, 255, 150);
        circle(this.x, this.y, 6);
    }

    checkCollect(player) {
        let d = dist(this.x, this.y, player.x, player.y);
        return d < player.radius + 8;
    }
}

class Monster {
    constructor(x, y) {
        this.x = x;
        this.y = y;
        this.speed = 1.2;
        this.size = 18;
    }

    update(player) {
        let angle = atan2(player.y - this.y, player.x - this.x);
        this.x += cos(angle) * this.speed;
        this.y += sin(angle) * this.speed;
    }

    draw() {
        noStroke();
        fill(20, 0, 0);
        circle(this.x, this.y, this.size * 2);

        fill(255, 30, 30);
        circle(this.x - 4, this.y - 2, 4);
        circle(this.x + 4, this.y - 2, 4);
    }

    checkHitPlayer(player) {
        let d = dist(this.x, this.y, player.x, player.y);
        return d < this.size + player.radius - 4;
    }
}
